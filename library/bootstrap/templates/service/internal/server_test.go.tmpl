func TestNewRouter_PlaygroundOff(t *testing.T) {
	passThroughAuth(t)
	withPlayground(t, false)

	router, err := NewRouter()
	require.NoError(t, err)
	require.Equal(t, http.StatusNotFound, serve(router, http.MethodGet, "/{{ .Module.Route }}/playground", "").Code)
}
{{- end }}

