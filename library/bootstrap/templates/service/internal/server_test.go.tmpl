func init() { gin.SetMode(gin.TestMode) }

func passThroughAuth(t *testing.T) {
	previous := auth.New
	t.Cleanup(func() { auth.New = previous })
	auth.New = func() (*auth.Directives, error) { return auth.PassThrough(), nil }
}

func serve(router http.Handler, method, path, body string) *httptest.ResponseRecorder {
	recorder := httptest.NewRecorder()
	request := httptest.NewRequest(method, path, strings.NewReader(body))
	request.Header.Set("Content-Type", "application/json")
	router.ServeHTTP(recorder, request)
	return recorder
}

func TestHealthHandlers(t *testing.T) {
	router := gin.New()
	router.GET("/up", healthzHandler(func(context.Context) error { return nil }))
	router.GET("/down", healthzHandler(func(context.Context) error { return errors.New("no db") }))
	router.GET("/livez", livezHandler)

	require.Equal(t, http.StatusOK, serve(router, http.MethodGet, "/up", "").Code)
	require.Equal(t, http.StatusServiceUnavailable, serve(router, http.MethodGet, "/down", "").Code)
	require.Equal(t, http.StatusOK, serve(router, http.MethodGet, "/livez", "").Code)
}

func TestPingDatabase_NotInitialised(t *testing.T) {
	previous := getDatabase
	t.Cleanup(func() { getDatabase = previous })
	getDatabase = func() *gorm.DB { return nil }

	require.Error(t, pingDatabase(context.Background()))
}

func withPlayground(t *testing.T, enabled bool) {
	previous := config.Viper
	t.Cleanup(func() { config.Viper = previous })
	config.Viper = viper.New()
	config.Viper.Set("server.playground", enabled)
}

func TestNewRouter(t *testing.T) {
	passThroughAuth(t)
	withPlayground(t, true)

	router, err := NewRouter()
	require.NoError(t, err)

	for _, prefix := range routePrefixes {
		require.Equal(t, http.StatusOK, serve(router, http.MethodGet, prefix+"/livez", "").Code, prefix)
{{- if .Module.GraphQL }}
		require.Equal(t, http.StatusOK, serve(router, http.MethodGet, prefix+"/{{ .Module.Route }}/playground", "").Code, prefix)
		require.Equal(t, http.StatusOK, serve(router, http.MethodPost, prefix+"/{{ .Module.Route }}", `{"query":"{ __typename }"}`).Code, prefix)
{{- end }}
	}
}
