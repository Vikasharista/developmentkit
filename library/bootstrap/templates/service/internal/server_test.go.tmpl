func TestInit_InvalidDSN(t *testing.T) {
	previous := config.Viper
	t.Cleanup(func() { config.Viper = previous })
	config.Viper = viper.New()
	config.Viper.Set("database.postgres.dsn", "host=127.0.0.1 port=1 user=none dbname=none sslmode=disable connect_timeout=1")

	require.Error(t, Init())
}
