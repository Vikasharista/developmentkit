# Local Postgres for `make serve` and the integration / e2e tests.
services:
  postgres:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: {{ .Service.DBName }}
    ports:
      - "${DB_PORT:-{{ .Service.DBPort }}}:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{ .Service.DBName }}"]
      interval: 2s
      timeout: 2s
      retries: 30
