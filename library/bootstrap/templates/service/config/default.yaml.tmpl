# Base config. Committed, so it holds no secrets: every secret arrives as a APP_*
# environment variable (core-lib maps APP_DATABASE_POSTGRES_DSN to
# database.postgres.dsn) or from the environment's mounted override file.
application:
  log_level: 0

server:
  port: "{{ .Service.Port }}"
  # GraphQL playground at /<module>/playground. Local only; keep it off in shared environments.
  playground: false

database:
  postgres:
    dsn: ""
    max_idle_connections: 5
    max_open_connections: 20

# Dev auth endpoints, as in backend-b. Each environment overrides them.
auth:
  provider: permsvc
  identity:
    url: https://auth-dev.{{ .Service.OrgDomain }}/identity
  permsvc:
    url: https://auth-dev.{{ .Service.OrgDomain }}/permission-service
  cache:
    ttl: 30m
    negative_ttl: 30s
    max_entries: 10000
  http:
    timeout: 5s
