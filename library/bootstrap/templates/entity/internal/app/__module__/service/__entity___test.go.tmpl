func Test{{ .Entity.Name }}Service_Get(t *testing.T) {
	ctx := context.Background()
	repository := &stub{{ .Entity.Name }}Repository{t: t}
	svc := &{{ .Entity.Var }}Service{repository: repository}

	repository.get = func(q *rqp.Query) ([]*model.{{ .Entity.Name }}, int, error) {
		require.Equal(t, default{{ .Entity.Name }}PageSize, q.Limit)
		return []*model.{{ .Entity.Name }}{sample{{ .Entity.Name }}Row(1)}, 7, nil
	}
	page, err := svc.Get(ctx, &coredto.QueryBuilder{
		Filters: []coredto.Filter{ {Field: "createdBy", Operator: "EQ", Value: "u"} },
		Sort:    []*coredto.Sort{ {SortBy: "createdAt", Order: coredto.DESC} },
	})
	require.NoError(t, err)
	require.Equal(t, 7, page.TotalCount)
	require.Len(t, page.Data, 1)

	repository.get = func(*rqp.Query) ([]*model.{{ .Entity.Name }}, int, error) { return nil, 0, errStub{{ .Entity.Name }} }
	_, err = svc.Get(ctx, &coredto.QueryBuilder{})
	require.ErrorIs(t, err, errStub{{ .Entity.Name }})

	for name, query := range map[string]*coredto.QueryBuilder{
		"page too large":   {Limit: max{{ .Entity.Name }}PageSize + 1},
		"negative size":    {Limit: -1},
		"bad like value":   {Filters: []coredto.Filter{ {Field: "id", Operator: "LIKE", Value: 5} }},
		"negative offset":  {Limit: 1, Offset: -1},
		"unknown column":   {Filters: []coredto.Filter{ {Field: "password", Operator: "EQ"} }},
		"unknown operator": {Filters: []coredto.Filter{ {Field: "id", Operator: "DROP"} }},
		"unknown sort":     {Sort: []*coredto.Sort{ {SortBy: "id; drop table x"} }},
	} {
		t.Run(name, func(t *testing.T) {
			_, err := svc.Get(ctx, query)
			require{{ $.Entity.Name }}Code(t, err, coreerrors.BadRequestErrorCode)
		})
	}
}
