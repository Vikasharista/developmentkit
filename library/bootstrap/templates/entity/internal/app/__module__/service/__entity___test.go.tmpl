func Test{{ .Entity.Name }}Service_Create(t *testing.T) {
	ctx := context.Background()
	repository := &stub{{ .Entity.Name }}Repository{t: t}
	svc := &{{ .Entity.Var }}Service{repository: repository}

	repository.create = func(m *model.{{ .Entity.Name }}) (*model.{{ .Entity.Name }}, error) {
		m.ID = {{ if eq .Entity.IDType "int" }}1{{ else }}"id-1"{{ end }}
		return m, nil
	}
	created, err := svc.Create(ctx, sampleCreate{{ .Entity.Name }}Request(1))
	require.NoError(t, err)
	require.Equal(t, {{ if eq .Entity.IDType "int" }}1{{ else }}"id-1"{{ end }}, created.ID)

	repository.create = func(*model.{{ .Entity.Name }}) (*model.{{ .Entity.Name }}, error) { return nil, errStub{{ .Entity.Name }} }
	_, err = svc.Create(ctx, sampleCreate{{ .Entity.Name }}Request(1))
	require.ErrorIs(t, err, errStub{{ .Entity.Name }})
{{- range .Entity.Fields }}{{ if and .Required (or (eq .Type "string") (eq .Type "text") (eq .Type "enum") (eq .Type "ref")) }}

	missing{{ .GoName }} := sampleCreate{{ $e.Name }}Request(1)
	missing{{ .GoName }}.{{ .GoName }} = ""
	_, err = svc.Create(ctx, missing{{ .GoName }})
	require{{ $.Entity.Name }}Code(t, err, coreerrors.BadRequestErrorCode)
{{- end }}{{ end }}
{{- range .Entity.Fields }}{{ if .CreatePtr }}

	missing{{ .GoName }} := sampleCreate{{ $e.Name }}Request(1)
	missing{{ .GoName }}.{{ .GoName }} = nil
	_, err = svc.Create(ctx, missing{{ .GoName }})
	require{{ $.Entity.Name }}Code(t, err, coreerrors.BadRequestErrorCode)
{{- end }}{{ end }}
{{- range .Entity.Enums }}

	bad{{ .GoName }} := sampleCreate{{ $e.Name }}Request(1)
	bad{{ .GoName }}.{{ .GoName }} = {{ if .Ptr }}utility.GetPointerToPrimitiveType("NOT_A_VALUE"){{ else }}"NOT_A_VALUE"{{ end }}
	_, err = svc.Create(ctx, bad{{ .GoName }})
	require{{ $.Entity.Name }}Code(t, err, coreerrors.BadRequestErrorCode)
{{- end }}

	fail{{ $.Entity.Name }}Copy(t)
	_, err = svc.Create(ctx, sampleCreate{{ .Entity.Name }}Request(1))
	require.Error(t, err)
}
{{- end }}
