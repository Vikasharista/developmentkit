func fail{{ $.Entity.Name }}Copy(t *testing.T) {
	previous := mapper.CopyWithOption
	t.Cleanup(func() { mapper.CopyWithOption = previous })
	mapper.CopyWithOption = func(interface{}, interface{}, copier.Option) error { return errors.New("copy failed") }
}

