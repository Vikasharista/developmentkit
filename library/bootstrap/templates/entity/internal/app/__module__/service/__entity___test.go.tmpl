func Test{{ .Entity.Name }}Service_Update(t *testing.T) {
	ctx := context.Background()
	repository := &stub{{ .Entity.Name }}Repository{t: t}
	svc := &{{ .Entity.Var }}Service{repository: repository}
	id := sample{{ .Entity.Name }}Row(1).ID
	seed := 2
	patch := &dto.Update{{ .Entity.Name }}Request{
{{- range .Entity.SampleFields }}
		{{ .GoName }}: {{ .SeedPatchGo }},
{{- end }}
		IsActive: utility.GetPointerToPrimitiveType(false),
	}

	repository.getByID = func({{ .Entity.IDGo }}) (*model.{{ .Entity.Name }}, error) { return sample{{ .Entity.Name }}Row(1), nil }
	repository.update = func(m *model.{{ .Entity.Name }}) (*model.{{ .Entity.Name }}, error) { return m, nil }
	updated, err := svc.Update(ctx, id, patch)
	require.NoError(t, err)
	require.False(t, updated.IsActive)

	repository.update = func(*model.{{ .Entity.Name }}) (*model.{{ .Entity.Name }}, error) { return nil, errStub{{ .Entity.Name }} }
	_, err = svc.Update(ctx, id, patch)
	require.ErrorIs(t, err, errStub{{ .Entity.Name }})

	repository.getByID = func({{ .Entity.IDGo }}) (*model.{{ .Entity.Name }}, error) { return nil, errStub{{ .Entity.Name }} }
	_, err = svc.Update(ctx, id, patch)
	require.ErrorIs(t, err, errStub{{ .Entity.Name }})
{{- range .Entity.Enums }}

	_, err = svc.Update(ctx, id, &dto.Update{{ $e.Name }}Request{ {{- .GoName }}: utility.GetPointerToPrimitiveType("NOT_A_VALUE")})
	require{{ $.Entity.Name }}Code(t, err, coreerrors.BadRequestErrorCode)
{{- end }}
{{- range .Entity.Fields }}{{ if eq .Type "string" }}

	_, err = svc.Update(ctx, id, &dto.Update{{ $e.Name }}Request{ {{- .GoName }}: utility.GetPointerToPrimitiveType(strings.Repeat("é", {{ add .MaxLen 1 }}))})
	require{{ $.Entity.Name }}Code(t, err, coreerrors.BadRequestErrorCode)
{{- end }}{{ if and .Required .IsText }}

	_, err = svc.Update(ctx, id, &dto.Update{{ $e.Name }}Request{ {{- .GoName }}: utility.GetPointerToPrimitiveType("")})
	require{{ $.Entity.Name }}Code(t, err, coreerrors.BadRequestErrorCode)
{{- end }}{{ end }}

	repository.getByID = func({{ .Entity.IDGo }}) (*model.{{ .Entity.Name }}, error) { return sample{{ .Entity.Name }}Row(1), nil }
	fail{{ $.Entity.Name }}Copy(t)
	_, err = svc.Update(ctx, id, patch)
	require.Error(t, err)
}
