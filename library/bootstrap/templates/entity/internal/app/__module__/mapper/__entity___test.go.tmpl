package mapper

import (
	"errors"
{{- if .Entity.NeedsFmt }}
	"fmt"
{{- end }}
	"testing"
{{- if .Entity.NeedsTime }}
	"time"
{{- end }}

	"{{ .Service.CoreModule }}/logger"
{{- if .Entity.HasType "jsonb" }}
	coremodel "{{ .Service.CoreModule }}/model"
{{- end }}
{{- if .Entity.NeedsUtility }}
	"{{ .Service.CoreModule }}/utility"
{{- end }}
